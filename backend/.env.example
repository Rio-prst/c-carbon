# PostgreSQL connection string used by the application runtime.
# For Supabase: Project Settings -> Database -> Connection string.
# - Persistent backend (default): session pooler, port 5432
# - Serverless / auto-scaling: transaction pooler, port 6543 + ?pgbouncer=true
DATABASE_URL=postgres://postgres.PROJECT_REF:PASSWORD@aws-REGION.pooler.supabase.com:5432/postgres

# Direct/session connection used by the Prisma CLI (generate, migrations).
# Must NOT point at the transaction-mode pooler (port 6543) — Prisma Migrate
# needs a single-connection, non-pooled session to the database.
DIRECT_URL=postgres://postgres.PROJECT_REF:PASSWORD@aws-REGION.pooler.supabase.com:5432/postgres

# Throwaway database used ONLY by `prisma migrate dev` (authoring new
# migrations). Prisma resets it on every run, and it never holds real data.
# Create it once in Supabase: SQL Editor -> CREATE DATABASE c_carbon_shadow;
# (this database is not visible in the Supabase dashboard — that is normal).
# Same host/credentials as DIRECT_URL, only the database name differs.
# `prisma migrate deploy` (production) does not need this.
SHADOW_DATABASE_URL=postgres://postgres.PROJECT_REF:PASSWORD@aws-REGION.pooler.supabase.com:5432/c_carbon_shadow

# Dedicated database used ONLY by integration/e2e tests (`pnpm test:int`,
# `pnpm test:e2e`). Never point it at the shared/dev database.
# Create it once in Supabase: SQL Editor -> CREATE DATABASE c_carbon_test;
# then apply the schema: pnpm prisma:deploy DATABASE_URL=... or via the env.
TEST_DATABASE_URL=postgres://postgres.PROJECT_REF:PASSWORD@aws-REGION.pooler.supabase.com:5432/c_carbon_test

# Secret used to sign and verify JWT tokens.
# MUST be replaced with a strong random value in any non-local environment.
JWT_SECRET=dev-secret-change-me

# JWT token lifetime. Accepts any value supported by `jsonwebtoken` expiresIn
# (e.g. "15m", "7d"). Defaults to 7d when unset.
JWT_EXPIRES_IN=7d

# HTTP port the API listens on.
PORT=3000