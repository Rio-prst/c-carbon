# PostgreSQL connection string.
# Leave as-is for a local dev database, or point to your dev/staging instance.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/c-carbon

# Secret used to sign and verify JWT tokens.
# MUST be replaced with a strong random value in any non-local environment.
JWT_SECRET=dev-secret-change-me

# HTTP port the API listens on.
PORT=3000