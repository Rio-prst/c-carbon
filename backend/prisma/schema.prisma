generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  FARMER
  CORPORATE
  ADMIN
}

enum FarmStatus {
  REGISTERED
  DATA_COLLECTION
  ASSESSED
  CARBON_CANDIDATE
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  farms    Farm[]
  corporate Corporate?

  @@map("users")
}

/// Corporate identity attached one-to-one to a user, per docs/DATABASE.md §11.
/// Registration only creates farmers, so this row is provisioned separately;
/// the demo seed is the MVP path.
model Corporate {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  companyName String   @map("company_name")
  industry    String
  region      String
  status      String   @default("ACTIVE") @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("corporates")
}

model Farm {
  id            String     @id @default(uuid())
  userId        String     @map("user_id")
  digitalFarmId String     @unique @map("digital_farm_id")
  name          String
  lat           Decimal    @db.Decimal(10, 7)
  lng           Decimal    @db.Decimal(10, 7)
  landAreaHa    Decimal    @map("land_area_ha") @db.Decimal(12, 4)
  commodity     String
  status        FarmStatus @default(REGISTERED)
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  user    User         @relation(fields: [userId], references: [id])
  seasons FarmSeason[]
  data    FarmData[]
  projects ProjectFarm[]

  @@index([userId])
  @@map("farms")
}

model FarmSeason {
  id             String    @id @default(uuid())
  farmId         String    @map("farm_id")
  seasonLabel    String?   @map("season_label") @db.VarChar(50)
  startDate      DateTime? @map("start_date") @db.Date
  endDate        DateTime? @map("end_date") @db.Date
  sequenceNumber Int?      @map("sequence_number")
  createdAt      DateTime  @default(now()) @map("created_at")

  farm Farm       @relation(fields: [farmId], references: [id], onDelete: Cascade)
  data FarmData[]

  @@index([farmId])
  @@map("farm_seasons")
}

enum FarmDataStatus {
  SELF_REPORTED
  REVIEW
  VERIFIED
  REJECTED
}

model FarmData {
  id                      String         @id @default(uuid())
  farmId                  String         @map("farm_id")
  farmSeasonId            String         @map("farm_season_id")
  yieldKg                 Decimal?       @map("yield_kg") @db.Decimal(10, 2)
  waterUsage              Decimal?       @map("water_usage") @db.Decimal(10, 2)
  fertilizerUsage         Decimal?       @map("fertilizer_usage") @db.Decimal(10, 2)
  pesticideUsage          Decimal?       @map("pesticide_usage") @db.Decimal(10, 2)
  wasteManagementPractice String?        @map("waste_management_practice") @db.VarChar(100)
  soilPractice            String?        @map("soil_practice") @db.VarChar(100)
  energyUsage             Decimal?       @map("energy_usage") @db.Decimal(10, 2)
  lowCarbonPractice       Boolean        @default(false) @map("low_carbon_practice")
  status                  FarmDataStatus @default(SELF_REPORTED)
  rejectionReason         String?        @map("rejection_reason")
  submittedAt             DateTime?      @map("submitted_at")
  createdAt               DateTime       @default(now()) @map("created_at")

  farm       Farm       @relation(fields: [farmId], references: [id], onDelete: Cascade)
  farmSeason FarmSeason @relation(fields: [farmSeasonId], references: [id], onDelete: Cascade)
  evidence   Evidence[]

  @@index([farmId])
  @@index([farmSeasonId])
  @@map("farm_data")
}

model Evidence {
  id         String   @id @default(uuid())
  farmDataId String   @map("farm_data_id")
  type       String?  @db.VarChar(20)
  url        String?
  fileName   String?  @map("file_name") @db.VarChar(255)
  uploadedAt DateTime @default(now()) @map("uploaded_at")

  farmData FarmData @relation(fields: [farmDataId], references: [id], onDelete: Cascade)

  @@index([farmDataId])
  @@map("evidence")
}

/// The MVP only reaches AGGREGATING. The later phases of the conceptual
/// lifecycle are listed in docs/DATABASE.md but must not be reachable in MVP,
/// since claiming verification or issuance happened would be a false
/// statement about the platform.
enum ProjectStatus {
  CANDIDATE
  ASSESSMENT
  AGGREGATING
  VERIFICATION
  REGISTRATION
  ISSUANCE
  TRADING
}

model CarbonProject {
  id             String        @id @default(uuid())
  name           String
  status         ProjectStatus @default(CANDIDATE)
  region         String
  commodityFocus String        @map("commodity_focus") @db.VarChar(100)
  totalFarms     Int           @default(0) @map("total_farms")
  totalAreaHa    Decimal       @default(0) @map("total_area_ha") @db.Decimal(12, 4)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  projectFarms ProjectFarm[]

  @@map("carbon_projects")
}

/// Membership of a farm in a project. total_farms and total_area_ha on the
/// project are a denormalised aggregate of these rows, so the unique pair is
/// what stops the same farm being counted twice.
model ProjectFarm {
  id              String        @id @default(uuid())
  carbonProjectId String        @map("carbon_project_id")
  farmId          String        @map("farm_id")
  addedAt         DateTime      @default(now()) @map("added_at")
  carbonProject   CarbonProject @relation(fields: [carbonProjectId], references: [id], onDelete: Cascade)
  farm            Farm          @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@unique([carbonProjectId, farmId])
  @@index([carbonProjectId])
  @@index([farmId])
  @@map("project_farms")
}
