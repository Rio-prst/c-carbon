# Base URL of the backend API used by the mobile app.
# - Android emulator: use http://10.0.2.2:3000 to reach the host machine
# - Expo Go on a physical device: use your computer's LAN IP, e.g. http://192.168.1.10:3000
# - Tunnel/remote: use the tunnel URL provided by the backend or a deployed instance
EXPO_PUBLIC_API_URL=http://localhost:3000